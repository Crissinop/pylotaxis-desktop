{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Finestra principale: solo i comandi che usa davvero (A.7.10). Nessun permesso dei plugin: dialog, opener, scorciatoia, link e istanza singola si usano solo da Rust. Dei permessi core: l'ascolto degli eventi, per sapere quando l'app si blocca (v0.3.0), e i sei della barra del titolo propria (v0.5.0).",
  "windows": ["main"],
  "permissions": [
    "allow-app-info",
    "allow-registry-list",
    "allow-category-create",
    "allow-category-rename",
    "allow-category-delete",
    "allow-executable-pick",
    "allow-app-create",
    "allow-app-update",
    "allow-app-delete",
    "allow-app-launch",
    "allow-lock-status",
    "allow-lock-now",
    "allow-unlock-pin",
    "allow-unlock-hello",
    "allow-hello-availability",
    "allow-security-set-pin",
    "allow-security-disable",
    "allow-security-set-hello",
    "allow-security-set-idle",
    "allow-secret-create",
    "allow-secret-update",
    "allow-secret-replace",
    "allow-secret-delete",
    "allow-secret-copy",
    "allow-shortcut-status",
    "allow-shortcut-set",
    "allow-tray-setup",
    "allow-group-create",
    "allow-group-update",
    "allow-group-delete",
    "allow-group-launch",
    "allow-health-status",
    "allow-autostart-status",
    "allow-autostart-set",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close"
  ]
}
